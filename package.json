{
    "name": "nido",
    "version": "0.2.2",
    "description": "Nido — a keyboard-first Neovim desktop client",
    "main": "./out/main/index.js",
    "author": "",
    "homepage": "https://github.com/kanata9819/Nido",
    "repository": {
        "type": "git",
        "url": "https://github.com/kanata9819/Nido.git"
    },
    "scripts": {
        "icons": "electron scripts/generate-icons.mjs",
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck:windows": "tsc -p tsconfig.windows-tests.json",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "electron-vite preview",
        "prepare:neovim": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-neovim.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-debugger.ps1 && npm ci --prefix resources/languages --ignore-scripts --no-audit --no-fund",
        "dev": "npm run prepare:neovim && electron-vite dev",
        "build": "npm run prepare:neovim && npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win --publish never",
        "build:mac": "electron-vite build && electron-builder --mac",
        "build:linux": "electron-vite build && electron-builder --linux",
        "test": "tsx --test --test-concurrency=1 tests/i18n.test.ts tests/session.test.ts tests/session-lifecycle.test.ts tests/session-performance.test.ts tests/neovim-ui.test.ts tests/git.test.ts tests/keyboard.test.ts tests/prepare-neovim.test.ts tests/scroll.test.ts tests/click.test.ts tests/updater.test.ts tests/sticky-scroll.test.ts",
        "test:e2e": "playwright test",
        "test:renderer": "playwright test --config playwright.renderer.config.ts",
        "test:windows": "playwright test --config playwright.windows.config.ts",
        "verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1",
        "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer.ps1",
        "test:rust": "tsx --test tests/rust.test.ts",
        "test:typescript": "tsx --test tests/typescript.test.ts",
        "test:debug": "tsx --test tests/debug.test.ts"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "electron-updater": "6.8.9",
        "lucide-react": "^1.48.0",
        "neovim": "^5.5.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.19.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^5.1.1",
        "electron": "^44.4.5",
        "electron-builder": "^26.0.12",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "prettier": "^3.7.4",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^7.2.6"
    }
}
